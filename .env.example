# Description: Example of .env file
# Usage: Duplicate this file as .env and change as needed.

# MongoDB URI (optional; dev and tests fall back to an in-memory MongoDB).
MONGO_URI=mongodb://localhost:27018/usthing

# Optional: dedicated MongoDB URI used when running tests.
# MONGO_TEST_URI=mongodb://localhost:27018/usthing

# Skip token verification entirely (local development / tests).
AUTH_SKIP=false
